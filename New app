// Driver ki location update karne ka function
async function updateDriverLocation(cabId: string, latitude: number, longitude: number) {
  const cabLocationRef = doc(db, "cabs_location", cabId);
  try {
    await setDoc(cabLocationRef, {
      latitude: latitude,
      longitude: longitude,
      updatedAt: new Date()
    }, { merge: true }); // merge: true se bakki data delete nahi hoga
    console.log("Location updated successfully!");
  } catch (error) {
    console.error("Error updating location: ", error);
  }
}

