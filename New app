import { doc, setDoc, updateDoc } from "firebase/firestore";
import { db } from "./firebase"; // Aapki firebase initialization file

// Aaj ki date (YYYY-MM-DD) format me nikalne ka helper function
const getTodayDate = () => new Date().toISOString().split("T")[0];

// 1. Time In (Check-In) Register Karna [Cloud Firestore]
export async function registerCheckIn(employeeId: string, cabNumber: string) {
  const today = getTodayDate();
  const attendanceRef = doc(db, "attendance", `${employeeId}_${today}`);

  try {
    await setDoc(attendanceRef, {
      employeeId,
      cabNumber,
      date: today,
      timeIn: new Date().toLocaleTimeString(), // Current system time
      timeOut: null, // Check-out ke waqt update hoga
      status: "Present"
    }, { merge: true });
    console.log("Check-in register ho gaya!");
  } catch (error) {
    console.error("Check-in error: ", error);
  }
}

// 2. Time Out (Check-Out) Register Karna [Cloud Firestore]
export async function registerCheckOut(employeeId: string) {
  const today = getTodayDate();
  const attendanceRef = doc(db, "attendance", `${employeeId}_${today}`);

  try {
    // Sirf timeOut field ko update karenge
    await updateDoc(attendanceRef, {
      timeOut: new Date().toLocaleTimeString()
    });
    console.log("Check-out register ho gaya!");
  } catch (error) {
    console.error("Check-out error: ", error);
  }
}

// 3. Employee Leave Apply Karna (Pehle se attendance status 'Leave' mark karna) [Cloud Firestore]
export async function applyLeave(employeeId: string, leaveDate: string) {
  const attendanceRef = doc(db, "attendance", `${employeeId}_${leaveDate}`);

  try {
    await setDoc(attendanceRef, {
      employeeId,
      date: leaveDate,
      timeIn: null,
      timeOut: null,
      status: "Leave"
    }, { merge: true });
    console.log("Leave apply ho gayi hai!");
  } catch (error) {
    console.error("Leave entry error: ", error);
  }
}
