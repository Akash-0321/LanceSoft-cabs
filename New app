// HTTP Endpoint to export report
export const exportMonthlyReport = onRequest(async (req, res) => {
  const month = req.query.month; // URL Parameter: ?month=2026-10
  
  if (!month) {
    res.status(400).send("Please specify month (e.g. ?month=2026-10)");
    return;
  }

  try {
    const attendanceRef = db.collection("attendance");
    // Filter attendance for the selected month [Cloud Firestore]
    const snapshot = await attendanceRef
      .where("date", ">=", `${month}-01`)
      .where("date", "<=", `${month}-31`)
      .get();

    // CSV Headers
    let csvContent = "Employee ID,Cab Number,Date,Time In,Time Out,Status\n";

    // Row-by-row data prepare karein
    snapshot.forEach(doc => {
      const data = doc.data();
      csvContent += `${data.employeeId},${data.cabNumber || "N/A"},${data.date},${data.timeIn || "N/A"},${data.timeOut || "N/A"},${data.status}\n`;
    });

    // Browser ko signal karein ki file download karni hai
    res.setHeader("Content-Type", "text/csv");
    res.setHeader("Content-Disposition", `attachment; filename=attendance_${month}.csv`);
    
    res.status(200).send(csvContent);
  } catch (error) {
    res.status(500).send("Error exporting data: " + error.toString());
  }
});
