// Driver ki location ko real-time track karne ka function
function listenToCabLocation(cabId: string, onLocationChange: (lat: number, lng: number) => void) {
  const cabLocationRef = doc(db, "cabs_location", cabId);

  // onSnapshot realtime data change ko listen karta hai [Cloud Firestore]
  const unsubscribe = onSnapshot(cabLocationRef, (snapshot) => {
    if (snapshot.exists()) {
      const data = snapshot.data();
      const { latitude, longitude } = data;
      onLocationChange(latitude, longitude); // UI ya Map update function call karein
    } else {
      console.log("No location data found.");
    }
  });

  return unsubscribe; // Jab tracking band karni ho tab listener close karne ke liye ise call karein
}

