import React, { useState, useEffect } from "react";
import { ActivityIndicator, View, Text, Button } from "react-native";
import { onAuthStateChanged, signOut } from "firebase/auth";
import { doc, getDoc } from "firebase/firestore";
import { auth, db } from "./src/config/firebase";

// Screens (Aap in files ko apne screens folder me banayenge)
import LoginScreen from "./src/screens/LoginScreen";
import AdminDashboard from "./src/screens/AdminDashboard";
import DriverScreen from "./src/screens/DriverScreen";
import EmployeeScreen from "./src/screens/EmployeeScreen";

export default function App() {
  const [user, setUser] = useState(null);
  const [role, setRole] = useState(null);
  const [status, setStatus] = useState("inactive"); // Default status
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // 1. User login/logout status check karein
    const unsubscribe = onAuthStateChanged(auth, async (authenticatedUser) => {
      if (authenticatedUser) {
        setUser(authenticatedUser);

        // 2. User ka role aur approval status database se fetch karein [Cloud Firestore]
        const userDocRef = doc(db, "users", authenticatedUser.uid);
        const docSnap = await getDoc(userDocRef);

        if (docSnap.exists()) {
          const userData = docSnap.data();
          setRole(userData.role);
          setStatus(userData.status); // Admin dynamic screen status control
        }
      } else {
        setUser(null);
        setRole(null);
        setStatus("inactive");
      }
      setLoading(false);
    });

    return unsubscribe;
  }, []);

  // Loading indicator jab tak status fetch ho raha hai
  if (loading) {
    return (
      <View style={{ flex: 1, justifyContent: "center", alignItems: "center" }}>
        <ActivityIndicator size="large" color="#00aaff" />
      </View>
    );
  }

  // 3. User logged in nahi hai -> Login Screen dikhayein
  if (!user) {
    return <LoginScreen />;
  }

  // 4. User logged in hai par Admin se approved nahi hai (Status checking)
  if (status !== "active") {
    return (
      <View style={{ flex: 1, justifyContent: "center", alignItems: "center", padding: 20 }}>
        <Text style={{ fontSize: 16, textAlign: "center", marginBottom: 20 }}>
          Aapka account approved nahi hai ya use deactivate kiya gaya hai. Admin se sampark karein.
        </Text>
        <Button title="Log Out" onPress={() => signOut(auth)} />
      </View>
    );
  }

  // 5. Role ke hisab se automatic screen display
  switch (role) {
    case "admin":
      return <AdminDashboard />;
    case "driver":
      return <DriverScreen />;
    case "employee":
      return <EmployeeScreen />;
    default:
      return <LoginScreen />;
  }
}
