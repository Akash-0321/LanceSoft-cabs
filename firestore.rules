rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }
    match /users/{uid} {
      // User may create only their own pending non-admin profile.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.role in ["employee", "driver", "vendor"]
        && !("admin" in request.resource.data);
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && resource.data.status == "pending"
          && request.resource.data.status == "pending"
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }
    match /attendance/{id} {
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "active";
      allow read: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || (approved() && resource.data.uid == request.auth.uid
          && resource.data.status == "active"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == "completed");
      allow delete: if isAdmin();
    }
    match /locationUpdates/{id} {
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow read: if isAdmin() || (approved() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}